# Large archives and local data/result roots
*.tar
*.tar.gz
*.tgz
*.zip
/data/
/datasets/
/outputs/
/results/
/artifacts/
/checkpoints/
/cache/
/tmp/

# Lightweight review artifacts belong only in git_eval
*.csv
*.tsv
*.log
*.png
*.jpg
*.jpeg
*.pdf
*.svg
*.html

!git_eval/**/*.csv
!git_eval/**/*.tsv
!git_eval/**/*.log
!git_eval/**/*.png
!git_eval/**/*.jpg
!git_eval/**/*.jpeg
!git_eval/**/*.pdf
!git_eval/**/*.svg
!git_eval/**/*.html

# Keep directory placeholders
!.gitkeep
